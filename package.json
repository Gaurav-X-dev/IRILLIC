{
  "name": "irillic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "dev": "next dev",
    "build": "next build",
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "start": "next start",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-db.ps1",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "admin:configure": "tsx --env-file=.env.local scripts/configure-super-admin.ts",
    "content:backfill": "tsx --env-file=.env.local scripts/backfill-dynamic-content.ts",
    "branding:backfill": "tsx --env-file=.env.local scripts/backfill-required-branding.ts",
    "sections:backfill": "tsx --env-file=.env.local scripts/backfill-page-sections.ts",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.460.0",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
