# ========================
# Database Configuration
# ========================
DATABASE_URL=postgresql://irillic_app:replace-with-a-strong-db-password@127.0.0.1:5433/irillic

# ========================
# Next.js Configuration
# ========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=IRILLIC

# ========================
# Authentication
# ========================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
ADMIN_NAME=IRILLIC Admin
ADMIN_EMAIL=admin@irillic.com
ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

# ========================
# Environment
# ========================
NODE_ENV=development
